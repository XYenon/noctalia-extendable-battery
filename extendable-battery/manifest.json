{
  "id": "extendable-battery",
  "name": "Extendable Battery",
  "version": "0.1.0",
  "minNoctaliaVersion": "4.7.7",
  "author": "XYenon",
  "license": "MIT",
  "repository": "https://github.com/XYenon/noctalia-extendable-battery",
  "description": "Extensible battery provider manager and native-style battery widget for Noctalia Shell.",
  "tags": ["Bar", "Panel", "Indicator", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "displayMode": "graphic-clean",
      "deviceKey": "__default__",
      "showPowerProfiles": false,
      "showNoctaliaPerformance": false,
      "hideIfNotDetected": true,
      "hideIfIdle": false,
      "preferBluetooth": true,
      "deviceNameFilter": ""
    }
  }
}
