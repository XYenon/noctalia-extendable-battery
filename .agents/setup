#!/usr/bin/env bash
set -euo pipefail

step_name=""
step_started=0

step() {
  if [[ -n "$step_name" ]]; then
    printf '<== %s completed in %ss\n' "$step_name" "$((SECONDS - step_started))"
  fi
  step_name="$1"
  step_started=$SECONDS
  printf '\n==> %s\n' "$1"
}

finish() {
  local status=$?
  if [[ -n "$step_name" ]]; then
    printf '<== %s %s in %ss\n' \
      "$step_name" "$([[ $status -eq 0 ]] && printf completed || printf failed)" \
      "$((SECONDS - step_started))"
  fi
}
trap finish EXIT

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step "Installing Wayland and setup prerequisites"
packages=(ca-certificates curl git grim jq python3 sway xz-utils)
missing=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

step "Installing Nix with the Determinate Nix Installer"
nix_profile=/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
if [[ ! -r "$nix_profile" ]]; then
  curl --proto '=https' --tlsv1.2 -sSfL https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm --diagnostic-endpoint=""
fi
# The installer cannot update the environment of this running process.
# shellcheck disable=SC1091
source "$nix_profile"

profile_marker="# noctalia-extendable-battery Determinate Nix environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# noctalia-extendable-battery Determinate Nix environment
if ! command -v nix >/dev/null 2>&1 \
    && [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  unset __ETC_PROFILE_NIX_SOURCED
  # shellcheck disable=SC1091
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
EOF
fi

step "Configuring the Noctalia binary cache"
nix_custom_conf=/etc/nix/nix.custom.conf
cache_marker="# noctalia binary cache"
if ! sudo grep -Fqx "$cache_marker" "$nix_custom_conf" 2>/dev/null; then
  printf '%s\n' \
    "$cache_marker" \
    'extra-substituters = https://noctalia.cachix.org' \
    'extra-trusted-public-keys = noctalia.cachix.org-1:pCOR47nnMEo5thcxNDtzWpOxNFQsBRglJzxWPp3dkU4=' \
    | sudo tee -a "$nix_custom_conf" >/dev/null
fi

step "Installing Noctalia v5"
noctalia_ref='github:noctalia-dev/noctalia/v5.0.0-beta.10#default'
installed_noctalia_ref="$(
  nix profile list --json \
    | jq -r '.elements.noctalia.originalUrl // empty'
)"
if [[ "$installed_noctalia_ref" != "${noctalia_ref%#default}" ]]; then
  if [[ -n "$installed_noctalia_ref" ]]; then
    nix profile remove noctalia
  fi
  nix profile add "$noctalia_ref"
fi

# This setup previously installed the unrelated Quickshell-based v4 package.
# Remove only that profile entry when upgrading a stale project snapshot.
if nix profile list --json | jq -e '.elements["noctalia-shell"]' >/dev/null 2>&1; then
  nix profile remove noctalia-shell
fi

step "Linking the v5 plugin into Noctalia's local development source"
plugin_dir="$HOME/.local/share/noctalia/plugins"
mkdir -p "$plugin_dir"
ln -sfn "$repo_root/extendable-battery" "$plugin_dir/extendable-battery"

config_dir="$HOME/.config/noctalia"
config_file="$config_dir/config.toml"
mkdir -p "$config_dir"
if [[ ! -e "$config_file" ]]; then
  cat >"$config_file" <<'TOML'
[shell]
telemetry_enabled = false
polkit_agent = false

[shell.animation]
enabled = false

[wallpaper]
enabled = false

[idle.behavior.lock]
enabled = false

[idle.behavior.screen-off]
enabled = false

[dock]
enabled = false

[bar.main]
position = "top"
start = ["launcher", "workspaces"]
center = ["clock"]
end = ["xyenon/extendable-battery:battery", "control-center"]

[plugins]
enabled = ["xyenon/extendable-battery"]
auto_update = "none"
TOML
fi

step "Validating the v5 plugin"
noctalia --version
noctalia plugins lint "$repo_root"
python3 - "$repo_root/extendable-battery" <<'PY'
import json
import pathlib
import sys
import tomllib

root = pathlib.Path(sys.argv[1])
with (root / "plugin.toml").open("rb") as handle:
    tomllib.load(handle)
for path in (root / "translations").glob("*.json"):
    json.loads(path.read_text(encoding="utf-8"))
for path in (root / "scripts").glob("*.py"):
    compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY
sway --version
command -v grim
