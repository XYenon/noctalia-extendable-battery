#!/usr/bin/env bash
set -euo pipefail

step() {
  printf '\n==> %s\n' "$1"
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step "Installing Wayland and setup prerequisites"
packages=(ca-certificates curl git grim jq sway xz-utils)
missing=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

step "Installing Nix with the Determinate Nix Installer"
nix_profile=/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
if [[ ! -r "$nix_profile" ]]; then
  curl --proto '=https' --tlsv1.2 -sSfL https://install.determinate.systems/nix \
    | sh -s -- install --no-confirm --diagnostic-endpoint=""
fi
# The installer cannot update the environment of this running process.
# shellcheck disable=SC1091
source "$nix_profile"

profile_marker="# noctalia-extendable-battery Determinate Nix environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# noctalia-extendable-battery Determinate Nix environment
if ! command -v nix >/dev/null 2>&1 \
    && [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  unset __ETC_PROFILE_NIX_SOURCED
  # shellcheck disable=SC1091
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
EOF
fi

step "Configuring the Noctalia binary cache"
nix_custom_conf=/etc/nix/nix.custom.conf
cache_marker="# noctalia-shell binary cache"
if ! sudo grep -Fqx "$cache_marker" "$nix_custom_conf" 2>/dev/null; then
  printf '%s\n' \
    "$cache_marker" \
    'extra-substituters = https://noctalia.cachix.org' \
    'extra-trusted-public-keys = noctalia.cachix.org-1:pCOR47nnMEo5thcxNDtzWpOxNFQsBRglJzxWPp3dkU4=' \
    | sudo tee -a "$nix_custom_conf" >/dev/null
fi

step "Installing Noctalia Shell v4.7.7"
if ! command -v noctalia-shell >/dev/null 2>&1; then
  nix profile add 'github:noctalia-dev/noctalia-shell/v4.7.7#default'
fi

step "Linking the repository plugins into Noctalia"
plugin_dir="$HOME/.config/noctalia/plugins"
mkdir -p "$plugin_dir"
ln -sfn "$repo_root/extendable-battery" "$plugin_dir/extendable-battery"
ln -sfn "$repo_root/keychron-battery-provider" "$plugin_dir/keychron-battery-provider"

plugin_settings_file="$repo_root/extendable-battery/settings.json"
if [[ ! -e "$plugin_settings_file" ]]; then
  cat >"$plugin_settings_file" <<'JSON'
{
  "displayMode": "icon-always",
  "hideIfNotDetected": false
}
JSON
fi

plugins_file="$HOME/.config/noctalia/plugins.json"
if [[ ! -e "$plugins_file" ]]; then
  cat >"$plugins_file" <<'JSON'
{
  "version": 2,
  "sources": [],
  "states": {
    "extendable-battery": { "enabled": true, "sourceUrl": "" },
    "keychron-battery-provider": { "enabled": true, "sourceUrl": "" }
  }
}
JSON
fi

settings_file="$HOME/.config/noctalia/settings.json"
if [[ ! -e "$settings_file" ]]; then
  cat >"$settings_file" <<'JSON'
{
  "settingsVersion": 59,
  "bar": {
    "position": "top",
    "widgets": {
      "left": [{ "id": "Launcher" }, { "id": "Clock" }],
      "center": [{ "id": "Workspace" }],
      "right": [
        {
          "id": "plugin:extendable-battery",
          "displayMode": "icon-always",
          "hideIfNotDetected": false
        },
        { "id": "ControlCenter" }
      ]
    },
    "screenOverrides": []
  },
  "general": {
    "animationDisabled": true,
    "showChangelogOnStartup": false,
    "telemetryEnabled": false
  },
  "wallpaper": {
    "enabled": true,
    "useSolidColor": true,
    "solidColor": "#15131f"
  },
  "dock": { "enabled": false },
  "idle": { "enabled": false }
}
JSON
fi

shell_state_file="$HOME/.cache/noctalia/shell-state.json"
if [[ ! -e "$shell_state_file" ]]; then
  mkdir -p "$(dirname "$shell_state_file")"
  cat >"$shell_state_file" <<'JSON'
{
  "changelogState": { "lastSeenVersion": "4.7.7" }
}
JSON
fi

step "Verifying the toolchain"
nix --version
noctalia-shell --version
sway --version
command -v grim
python3 - "$repo_root/keychron-battery-provider/scripts" <<'PY'
import pathlib
import sys

for path in pathlib.Path(sys.argv[1]).glob("*.py"):
    compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY
